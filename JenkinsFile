@Library("shared") _
pipeline {
    agent { label "jenkins-agent" }

    stages {
        stage('code') {
            steps {
                script{
                clone("https://github.com/Ajaylogaom1/Automated-CICD-Pipeline-Project.git" ,"main")
                }
            }
        }
        stage('build') {
            steps {
                 script{
                     docker_build("restuarant-app","latest","logaomajay")
                 }
            }
        }
        stage('push code in dockerhub') {
            steps {
                script{
                    docker_push("restuarant-app","latest","logaomajay")
                }
            }
        }
        stage('deploy'){
            steps {
                script{
                    docker_compose()
                }
            }
        }
    }
}
