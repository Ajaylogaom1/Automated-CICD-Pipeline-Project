pipeline {
    agent {
        label 'jenkins-agent'
    }
    stages {
        stage('code') {
            steps {
                git url: "https://github.com/Ajaylogaom1/Automated-CICD-Pipeline-Project.git" , branch:"main"
            }
        }
     stage('build') {
            steps {
                sh "docker build -t restuarant-app:latest ."
            }
        }
        stage('push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId:"jenkinscred",
                    usernameVariable:"dockerHubUser", 
                    passwordVariable:"dockerHubPass")]){
                sh 'echo $dockerHubPass | docker login -u $dockerHubUser --password-stdin'
                sh "docker image tag restuarant-app:latest ${env.dockerHubUser}/restuarant-app:latest"
                sh "docker push ${env.dockerHubUser}/restuarant-app:latest"
                }
            }
        }
        stage('deploy') {
            steps {
                sh "docker compose up -d"
            }
        }
    }
}
